#!name=乐刻健身去广告
#!desc=拦截乐刻 App 开屏广告
#!system=ios

[URL Rewrite]
^https:\/\/lens\.leoao\.com\/lens\/conduct\/app\/rpc\/v2\/com\.lefit\.dubbo\.cms\.api\.bff\.ClientFrontFacade\/queryHomeMiddleInfo - reject-200
[Map Local]
# 1. 开屏广告接口 (返回 {"code":0,"data":[],"msg":"success"})
^https:\/\/lens\.leoao\.com\/lens\/conduct\/app\/rpc\/v2\/com\.lefit\.dubbo\.cms\.api\.front\.AppAdvertisingFrontService\/getAppAdvertisingNew data="eyJjb2RlIjoyMDAsImRhdGEiOltdLCJtc2ciOiJzdWNjZXNzIn0="
# 2. 首页配置接口 (返回 {"code":0,"data":{"list":[]},"msg":"success"})
^https:\/\/lens\.leoao\.com\/lens\/conduct\/app\/rpc\/v2\/com\.lefit\.dubbo\.cms\.api\.front\.AdvertiseConfigFrontService\/getAdvertiseConfigNew data="eyJjb2RlIjoyMDAsImRhdGEiOnsibGlzdCI6W119LCJtc2ciOiJzdWNjZXNzIn0="

[MITM]
hostname = %APPEND% lens.leoao.com
