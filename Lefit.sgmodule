#!name=乐刻健身去广告 (优化版)
#!desc=屏蔽开屏及首页中部推广。采用 Map Local 方式返回空数据，比 reject-dict 更能避免 App 报错。
#!system=ios

[Map Local]
# 拦截开屏广告及配置接口，返回空 JSON 字典
^https:\/\/lens\.leoao\.com\/lens\/conduct\/app\/rpc\/v2\/com\.lefit\.dubbo\.cms\.api\.front\.AppAdvertisingFrontService\/getAppAdvertisingNew data-type=text data="{}"
^https:\/\/lens\.leoao\.com\/lens\/conduct\/app\/rpc\/v2\/com\.lefit\.dubbo\.cms\.api\.bff\.ClientFrontFacade\/queryHomeMiddleInfo data-type=text data="{}"
^https:\/\/lens\.leoao\.com\/lens\/conduct\/app\/rpc\/v2\/com\.lefit\.dubbo\.cms\.api\.front\.AdvertiseConfigFrontService\/getAdvertiseConfigNew data-type=text data="{}"

[MITM]
hostname = %APPEND% lens.leoao.com